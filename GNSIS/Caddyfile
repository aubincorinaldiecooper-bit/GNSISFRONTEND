{
	auto_https off
}

:{$PORT:8080} {
	root * /usr/share/caddy
	encode gzip

	handle /health {
		respond "ok" 200
	}

	# The runtime config is regenerated on every container start and must never be
	# cached by the browser or any intermediary — otherwise a redeploy could serve
	# stale API/auth URLs from cache.
	@envjs path /env.js
	header @envjs Cache-Control "no-store"

	# The live page is the site's front door, and it is static: HTML, a
	# stylesheet, a script, two fonts, some SVGs and a pre-drawn QR. All of it is
	# served from this container, so a visitor sees the page immediately.
	#
	# It used to be forwarded to the runtime. That was wrong: the runtime loads
	# MiniCPM-o and the Thinker checkpoint onto a GPU inside build_app(), and only
	# then binds its port, so Modal could not route a request until the whole
	# model was in GPU memory. Looking at a QR code cost a full cold start —
	# measured at gnsis.studio as two requests held 125 seconds each before the
	# browser gave up.
	@livepage path / /live
	rewrite @livepage /live.html

	redir /welcome / permanent
	redir /home / permanent

	# Only the sockets reach the runtime, which is where a GPU is genuinely
	# needed. The model now starts when somebody starts a session, not when they
	# look at the page.
	#
	# Host and X-Forwarded-Host are left to Caddy: for an https:// upstream it
	# already sends the upstream's hostname as Host and forwards this site's host.
	# X-Forwarded-Proto is asserted because Railway terminates TLS and speaks
	# plain HTTP to this container.
	# X-GNSIS-Edge is a shared secret proving a socket came through this front
	# door. The runtime's own address is public, so without it a caller who
	# learns that address reaches the GPU directly — around this proxy, around
	# Cloudflare, and around every limit either of them applies. The runtime
	# refuses a socket that arrives without the value.
	#
	# Unset here the header simply goes out empty. That is safe only while the
	# runtime's own secret is also unset, because the runtime's value — not this
	# one — is what switches its check on. Runtime set with this unset means an
	# empty header arriving at a runtime that is checking, and every session is
	# refused. So set this end FIRST, and on a rollback clear it LAST.
	@sockets path /ws/*
	handle @sockets {
		reverse_proxy {$GNSIS_LIVE_UPSTREAM:https://unset.invalid} {
			header_up X-Forwarded-Proto https
			# Modal proxy auth protects the web endpoint itself, including
			# /health and both WebSockets, before a request can wake the GPU.
			# These stay server-side in Railway; they are never emitted to env.js.
			header_up Modal-Key {$MODAL_PROXY_KEY}
			header_up Modal-Secret {$MODAL_PROXY_SECRET}
			# Keep the application-layer edge proof as defense in depth: Modal
			# auth says this caller may reach the endpoint; this says the live
			# socket actually passed through the approved GNSIS front door.
			header_up X-GNSIS-Edge {$GNSIS_EDGE_SECRET}
		}
	}

	# Everything else is the React bundle: /login and the control plane under
	# /admin, with the usual single-page fallback.
	handle {
		try_files {path} /index.html
		file_server
	}
}
