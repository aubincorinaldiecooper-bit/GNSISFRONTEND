{
	auto_https off
}

:{$PORT:8080} {
	root * /usr/share/caddy
	encode gzip

	handle /health {
		respond "ok" 200
	}

	# The runtime config is regenerated on every container start and must never be
	# cached by the browser or any intermediary — otherwise a redeploy could serve
	# stale API/auth URLs from cache.
	@envjs path /env.js
	header @envjs Cache-Control "no-store"

	# The site's front door is the live session page. The older public entry
	# points resolve there too.
	rewrite / /live
	redir /welcome / permanent
	redir /home / permanent

	# The live session is served by the GNSIS runtime (the GPU service) and shown
	# under this domain: the page, its assets, the QR and both websockets are
	# forwarded to it. Nothing else is — the control plane under /admin, /login
	# and the app bundle are served from this container as before.
	#
	# Modal routes requests by hostname. Caddy already sends the upstream's own
	# hostname as Host when the upstream is https://, and already forwards this
	# site's host as X-Forwarded-Host — so the upstream must be given with its
	# scheme, and neither header is set here. The runtime reads X-Forwarded-Host
	# and X-Forwarded-Proto when it draws /live/qr.svg, so the code encodes this
	# domain rather than the runtime's. The scheme IS asserted, because Railway
	# terminates TLS and speaks plain HTTP to this container: left to Caddy it
	# would read "http", and the runtime refuses to draw a code for a plain-http
	# address.
	@live path /live /live/* /assets/live.css /assets/live.js /assets/live/* /assets/mic-worklet.js /ws/*
	handle @live {
		reverse_proxy {$GNSIS_LIVE_UPSTREAM:https://unset.invalid} {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
