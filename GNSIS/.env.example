# ---- GNSIS frontend configuration (public values only) ----
# Everything here ships to the browser bundle. NEVER put a server secret in a
# VITE_ var: GNSIS_API_KEY, OPENROUTER_API_KEY, BETTER_AUTH_SECRET,
# GNSIS_VIRTUAL_KEY_PEPPER, GNSIS_AUTH_INTERNAL_SECRET, the GitHub client secret,
# and any Stripe secret / webhook secret belong only on the backend / auth service.

# Base URL of the GNSIS FastAPI backend (no trailing slash), e.g.
# https://gnsisbackend-production.up.railway.app
VITE_API_BASE_URL=

# Base URL of the Better Auth service (no trailing slash), e.g.
# https://gnsis-auth-production.up.railway.app
VITE_AUTH_URL=

# GitHub App slug — used only to build the public "Install the app" link.
VITE_GITHUB_APP_SLUG=

# Show the Integration Lab (/admin/integration-test) in the control-plane nav.
# Default: true.
VITE_ENABLE_INTEGRATION_LAB=true

# Public beta is the default product surface. Set false to restore internal
# Dashboard, Billing, Integration Lab, usage, and Advisor controls.
VITE_PUBLIC_BETA_MODE=true

# Model id pre-filled in the gateway smoke test. Must be a model your backend's
# OpenRouter key can call, e.g. anthropic/claude-opus-4.8
VITE_SMOKE_TEST_MODEL=

# DEPRECATED — old name for VITE_API_BASE_URL. Only used as a fallback when
# VITE_API_BASE_URL is unset. Prefer VITE_API_BASE_URL for new deployments.
# VITE_API_URL=

# ---- Read by Caddy, not by the app bundle (so not a VITE_ variable) ----
# Address of the GNSIS realtime runtime — the GPU service that serves the live
# session, e.g. https://<workspace>--gnsis-voice-gnsis-server.modal.run
#
# Address of the GNSIS realtime runtime — the GPU service that serves the live
# session. Caddy forwards only /ws/duplex and /ws/screen there; the page itself
# is served from this container (see Caddyfile). Unset, the sockets answer 502
# while the page, /admin and /login keep working.
GNSIS_LIVE_UPSTREAM=

# Modal proxy-token credentials for the protected gnsis-voice web endpoint.
# These are server-side Caddy variables, not browser config. They are distinct
# from MODAL_TOKEN_ID/MODAL_TOKEN_SECRET and must never be prefixed with VITE_.
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Shared secret Caddy stamps on every socket it forwards, which the runtime
# checks before it will start a session.
#
# Why: the runtime has its own public address. A caller who learns it reaches
# the GPU without passing this proxy — and so without passing Cloudflare, the
# rate limit, or anything else applied at the front door. With this set on both
# ends, that route answers a closed socket instead.
#
# A long random value, e.g. `openssl rand -hex 32`. It is a server secret: it
# never goes in a VITE_ variable and never reaches the browser.
#
# The RUNTIME's copy of this value is the switch, not this one. While the
# runtime's is unset its check is off and it accepts anything, so setting this
# end early is harmless. The reverse is not: runtime set with this one unset
# sends an empty header to a runtime that is checking, and every live session
# is refused.
#
# So: set this end FIRST, the runtime's second, and on a rollback clear the
# runtime's FIRST and this one last. Never clear this while the runtime still
# has a value.
GNSIS_EDGE_SECRET=
